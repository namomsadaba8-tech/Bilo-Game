<!DOCTYPE html>
<html lang="om">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BILO SHOP</title>

<style>
*{box-sizing:border-box}

body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#f3f4f6;
 color:#111827;
}

header{
 background:#111827;
 color:white;
 padding:14px;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:6px;
 position:sticky;
 top:0;
 z-index:1000;
}

.logo{
 font-size:19px;
 font-weight:bold;
}

button{
 border:0;
 border-radius:8px;
 padding:10px 13px;
 font-weight:bold;
 cursor:pointer;
}

.menu{background:#2563eb;color:white}
.cart{background:#22c55e;color:white}

nav{
 display:none;
 background:#1f2937;
 padding:10px;
}

nav.show{display:block}

nav a{
 display:block;
 padding:12px;
 color:white;
 text-decoration:none;
 border-bottom:1px solid #374151;
}

.hero{
 background:linear-gradient(135deg,#2563eb,#7c3aed);
 color:white;
 text-align:center;
 padding:50px 20px;
}

.biglogo{font-size:55px}

.hero h1{
 font-size:30px;
 margin:10px 0;
}

.hero p{
 font-size:17px;
 line-height:1.6;
}

.shop{
 background:#facc15;
 color:#111827;
 padding:14px 25px;
 margin-top:10px;
}

.offer{
 margin:20px;
 padding:22px;
 background:#111827;
 color:white;
 border-radius:15px;
 text-align:center;
 box-shadow:0 4px 12px #ccc;
}

.offer h2{color:#facc15}

.offer button{
 background:#22c55e;
 color:white;
}

.container{padding:20px}

.search{
 width:100%;
 padding:14px;
 border:1px solid #ddd;
 border-radius:9px;
 margin-bottom:20px;
}

.categories{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:8px;
 margin-bottom:25px;
}

.category{
 background:white;
 padding:13px 5px;
 border-radius:10px;
 text-align:center;
 box-shadow:0 2px 6px #ddd;
 cursor:pointer;
}

.category-icon{font-size:28px}

.category p{
 margin:5px 0 0;
 font-size:12px;
 font-weight:bold;
}

.products{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
}

.product{
 background:white;
 padding:15px;
 border-radius:12px;
 text-align:center;
 box-shadow:0 2px 8px #ddd;
}

.image{
 font-size:65px;
 background:#f8fafc;
 border-radius:10px;
 padding:10px;
}

.price{
 color:#16a34a;
 font-weight:bold;
}

.add{background:#2563eb;color:white;margin-top:5px}
.details{background:#f59e0b;color:white;margin-top:5px}
.buy{background:#16a34a;color:white;margin-top:5px}
.close{background:#6b7280;color:white;margin-top:5px}

.detailbox,
.cartbox,
.orderbox{
 display:none;
 background:white;
 margin-top:20px;
 padding:20px;
 border-radius:12px;
 box-shadow:0 2px 8px #ddd;
}

.detailimage{
 font-size:90px;
 text-align:center;
 background:#f8fafc;
 padding:20px;
 border-radius:12px;
}

.input{
 width:100%;
 padding:13px;
 margin:8px 0;
 border:1px solid #ddd;
 border-radius:8px;
}

.whatsapp{
 background:#25D366;
 color:white;
 width:100%;
 margin-top:10px;
}

.payment{
 background:white;
 padding:20px;
 border-radius:12px;
 margin-top:25px;
 box-shadow:0 2px 8px #ddd;
}

.contact{
 background:#e0f2fe;
 padding:20px;
 border-radius:12px;
 margin-top:25px;
}

footer{
 background:#111827;
 color:white;
 text-align:center;
 padding:30px 20px;
 margin-top:30px;
}

.footer-logo{
 font-size:24px;
 font-weight:bold;
}

@media(max-width:500px){
 .categories{grid-template-columns:1fr 1fr}
 .logo{font-size:15px}
 .hero h1{font-size:27px}
 .biglogo{font-size:45px}
}
</style>
</head>

<body>

<header>

<div class="logo">🛍️ BILO SHOP</div>

<button class="menu" onclick="openMenu()">
☰ MENU
</button>

<button class="cart" onclick="openCart()">
🛒 <span id="number">0</span>
</button>

</header>

<nav id="nav">
<a href="#home">🏠 Home</a>
<a href="#products">🛍️ Products</a>
<a href="#categories">📂 Categories</a>
<a href="#payment">💳 Payment</a>
<a href="#contact">📞 Contact</a>
</nav>

<section class="hero" id="home">

<div class="biglogo">🛍️</div>

<h1>WELCOME TO BILO SHOP</h1>

<p>
Electronics fi Smart Products
<br>
Qulqullina gaarii • Gatii madaalawaa
</p>

<button class="shop" onclick="goProducts()">
🛍️ SHOP NOW
</button>

</section>

<div class="offer">

<h2>🔥 SPECIAL OFFER</h2>

<p>
Meeshaalee electronics filatamoo
gatii gaariin argadhaa!
</p>

<button onclick="goProducts()">
🔥 VIEW PRODUCTS
</button>

</div>

<div class="container">

<input
class="search"
id="search"
placeholder="🔎 Product barbaadi..."
onkeyup="searchProduct()"
>

<h2 id="categories">📂 Categories</h2>

<div class="categories">

<div class="category" onclick="filterCategory('phone')">
<div class="category-icon">📱</div>
<p>Phones</p>
</div>

<div class="category" onclick="filterCategory('audio')">
<div class="category-icon">🎧</div>
<p>Audio</p>
</div>

<div class="category" onclick="filterCategory('watch')">
<div class="category-icon">⌚</div>
<p>Watches</p>
</div>

<div class="category" onclick="filterCategory('speaker')">
<div class="category